{
  "name": "instastore",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "prepare": "husky",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check src package.json tsconfig.json tsconfig.build.json nest-cli.json jest.config.ts",
    "format:write": "oxfmt --write src package.json tsconfig.json tsconfig.build.json nest-cli.json jest.config.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node --enable-source-maps dist/main",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "db:migrate": "typeorm -d dist/shared/infrastructure/configuration/dataSource.js migration:run",
    "db:rollback": "typeorm -d dist/shared/infrastructure/configuration/dataSource.js migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/observe": "^0.3.9",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "dotenv": "^17.4.1",
    "joi": "^18.2.9",
    "luxon": "^3.7.2",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
