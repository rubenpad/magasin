{
  "name": "instastore",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "prepare": "husky",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check src package.json tsconfig.json tsconfig.build.json nest-cli.json jest.config.ts",
    "format:write": "oxfmt --write src package.json tsconfig.json tsconfig.build.json nest-cli.json jest.config.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "typeorm -d dist/shared/infrastructure/configuration/dataSource.js migration:run",
    "db:rollback": "typeorm -d dist/shared/infrastructure/configuration/dataSource.js migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "joi": "^18.2.9",
    "luxon": "^3.7.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "esbuild-register": "^3.6.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
