{
  "compilerOptions": {
    "lib": ["ESNext", "ESNext.Iterator"],
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "esnext",
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "./dist",
    "types": ["node", "jest"],
    "paths": {
      "@domain/*": ["./src/find-closest-store/domain/*"],
      "@infrastructure/*": ["./src/find-closest-store/infrastructure/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  }
}
